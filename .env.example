# Drive automation AI defaults (backend only)
AI_PROVIDER=openai
AI_FALLBACK_ENABLED=false

# Meeting transcription with speaker diarization
TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
TRANSCRIPTION_LANGUAGE=zh

# Cost-sensitive structured meeting summary
SUMMARY_PROVIDER=openai
SUMMARY_MODEL=gpt-5.6-luna
SUMMARY_REASONING_EFFORT=low
SUMMARY_RESPONSE_FORMAT=json_schema

# Keep the real key in Secret Manager in production.
# For local development only, copy this file to .env and fill the value there.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_STORE=false

# Processing guardrails
MAX_ACTIVE_JOBS=1
ARTIFACT_RETENTION_DAYS=30

