{
  "manifest_version": 3,
  "name": "Auto Meeting Minutes - Google Meet CC Capturer",
  "version": "1.0.0",
  "description": "開啟 Google Meet 字幕時自動擷取內容並存檔，會議結束後可一鍵使用 Gemini API 整理會議紀錄並寄出 Email。",
  "permissions": [
    "storage",
    "downloads",
    "offscreen",
    "tabCapture",
    "activeTab",
    "desktopCapture"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "css": ["meet-overlay.css"],
      "run_at": "document_end"
    }
  ]
}
